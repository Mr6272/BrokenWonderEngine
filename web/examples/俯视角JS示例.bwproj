  "packs": [],
  "scripts": {
    "player": {
      "name": "player",
      "file": "player.js",
      "source": "// player.js —— 玩家控制：WASD/方向键移动、撞墙与边界钳制、相机跟随、空格挥剑、拾取金币。\n// 全局变量统一 P_ 前缀：脚本之间共享同一个 bwe 全局，前缀能避免撞名（docs/scripting-api.md §1）。\nvar P_CFG = {\n  speed: 190,          // 像素/秒\n  half: 10,            // 碰撞半宽（像素）\n  attackRange: 76,\n  attackDamage: 12,\n  attackCooldown: 0.45,\n  coinRadius: 24\n};\n\nvar P_STATE = {\n  ready: false,\n  cool: 0,\n  gold: 0,\n  moved: false,\n  attacks: 0,\n  // 在 onStart 里按地图尺寸填；提前声明这两个字段，编辑器的类型检查才能推断出来\n  // （否则 P_STATE 会被推断成字面量类型，赋值 mapW/mapH 会报「属性不存在」）。\n  mapW: 0,\n  mapH: 0\n};\n\nfunction onStart(ctx) {\n  var map = bwe.world.mapSize();\n  P_STATE.mapW = map.w;\n  P_STATE.mapH = map.h;\n  // 相机交给脚本（文档 §2.4）：平滑跟随 + 限制在地图内。\n  bwe.camera.follow(ctx.self, { smooth: 0.18 });\n  bwe.camera.bounds({ x: 0, y: 0, w: map.w, h: map.h });\n  P_STATE.ready = true;\n  bwe.log(\"[脚本] player ready：地图 \" + map.w + \"x\" + map.h + \"（WASD 移动 / 空格挥剑 / E 交互）\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!P_STATE.ready || !me || me.alive === false) return;\n  if (P_STATE.cool > 0) P_STATE.cool = Math.max(0, P_STATE.cool - dt);\n  move(me, dt);\n  if (bwe.input.pressed(\"Space\") || bwe.input.pressed(\"KeyJ\")) swing(me);\n  collectCoins(me);\n}\n\nfunction move(me, dt) {\n  var axis = bwe.input.axis(); // 已归一化：WASD 与方向键都算（文档 §2.3）\n  if (!axis || (axis.x === 0 && axis.y === 0)) return;\n  if (!P_STATE.moved) {\n    P_STATE.moved = true;\n    bwe.log(\"[脚本] player 开始移动\");\n  }\n  var step = P_CFG.speed * dt;\n  var nx = me.x + axis.x * step;\n  var ny = me.y + axis.y * step;\n  // 撞墙：分两个轴判，贴墙时还能沿墙滑（bwe.tilemap.blocked 是像素 AABB）\n  if (!solid(nx, me.y)) me.setPos(nx, me.y);\n  if (!solid(me.x, ny)) me.setPos(me.x, ny);\n  clampToMap(me);\n}\n\nfunction solid(x, y) {\n  var h = P_CFG.half;\n  return bwe.tilemap.blocked(x - h, y - h, h * 2, h * 2);\n}\n\nfunction clampToMap(me) {\n  var h = P_CFG.half;\n  var x = Math.max(h, Math.min(P_STATE.mapW - h, me.x));\n  var y = Math.max(h, Math.min(P_STATE.mapH - h, me.y));\n  if (x !== me.x || y !== me.y) me.setPos(x, y);\n}\n\nfunction swing(me) {\n  if (P_STATE.cool > 0) return;\n  P_STATE.cool = P_CFG.attackCooldown;\n  P_STATE.attacks += 1;\n  bwe.camera.shake(3, 0.12);\n  var list = enemies(me);\n  var hit = 0;\n  for (var i = 0; i < list.length; i++) {\n    if (me.distanceTo(list[i]) <= P_CFG.attackRange) {\n      list[i].damage(P_CFG.attackDamage);\n      hit += 1;\n    }\n  }\n  bwe.log(\"[脚本] 玩家挥剑（第 \" + P_STATE.attacks + \" 次），命中 \" + hit + \" 个敌人\");\n}\n\nfunction collectCoins(me) {\n  var coins = bwe.world.findAll({ tag: \"金币\" }) || [];\n  for (var i = 0; i < coins.length; i++) {\n    var coin = coins[i];\n    if (!coin || coin.alive === false) continue;\n    if (me.distanceTo(coin) > P_CFG.coinRadius) continue;\n    bwe.world.destroy(coin);\n    P_STATE.gold += 1;\n    bwe.save.set(\"gold\", P_STATE.gold);\n    bwe.world.emit(\"gold\", { gold: P_STATE.gold });\n    bwe.log(\"[脚本] 拾取金币 x\" + P_STATE.gold);\n  }\n}\n\n// 追击怪识别：标签 / 名字 / props.enemy 三选一都算。\n// 为什么要有 props.enemy：bwe.spawner.create 刷出来的实体没有 tags 也没有名字，\n// chaser.js 在 onStart 里给自己 setProp(\"enemy\", \"1\") 打标记，这里就能认出来。\nfunction enemies(me) {\n  var all = bwe.world.entities() || [];\n  var out = [];\n  for (var i = 0; i < all.length; i++) {\n    var e = all[i];\n    if (!e || e.alive === false || e.id === me.id) continue;\n    var byTag = e.tags && typeof e.tags.includes === \"function\" ? e.tags.includes(\"敌人\") : false;\n    var byName = !!(e.name && e.name.indexOf(\"追击怪\") >= 0);\n    var byProp = String(e.prop(\"enemy\", \"\")) === \"1\";\n    if (byTag || byName || byProp) out.push(e);\n  }\n  return out;\n}\n\nfunction onDamage(ctx, amount, from) {\n  bwe.log(\"[脚本] 玩家受击 -\" + Math.round(amount));\n  bwe.camera.shake(5, 0.2);\n}\n\nfunction onDeath(ctx, by) {\n  bwe.log(\"[脚本] 玩家阵亡，金币归零\");\n  bwe.world.emit(\"gameover\", {});\n}\n",
      "lang": "js"
    },
    "chaser": {
      "name": "chaser",
      "file": "chaser.js",
      "source": "// chaser.js —— 追击怪：用 bwe.nav.find 走 A* 追玩家，贴身咬人，死亡掉金币。\nvar C_CFG = {\n  speed: 92,\n  attackRange: 38,\n  damage: 6,\n  cooldown: 1.1,\n  repath: 0.4\n};\n\nvar C_STATE = {\n  ready: false,\n  path: [],\n  repathT: 0,\n  cool: 0,\n  following: false,\n  hits: 0\n};\n\nfunction onStart(ctx) {\n  C_STATE.ready = true;\n  // 给自己打一个 props 标记：spawner 刷出来的追击怪没有 tags/名字，\n  // player.js 靠这个 prop 认出「这是可以砍的敌人」（文档 §2.2 e.setProp / e.prop）。\n  if (ctx.self) ctx.self.setProp(\"enemy\", \"1\");\n  bwe.log(\"[脚本] chaser ready：\" + (ctx.self && ctx.self.name ? ctx.self.name : \"追击怪\"));\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!C_STATE.ready || !me || me.alive === false) return;\n  var target = bwe.world.find({ tag: \"玩家\" });\n  if (!target || target.alive === false) return;\n  if (C_STATE.cool > 0) C_STATE.cool = Math.max(0, C_STATE.cool - dt);\n\n  var dist = me.distanceTo(target);\n  if (dist <= C_CFG.attackRange) {\n    // 贴脸：停下、咬人\n    bwe.nav.stop(me);\n    C_STATE.following = false;\n    if (C_STATE.cool <= 0) {\n      C_STATE.cool = C_CFG.cooldown;\n      C_STATE.hits += 1;\n      target.damage(C_CFG.damage);\n      bwe.log(\"[脚本] 追击怪咬到玩家 -\" + C_CFG.damage + \"（第 \" + C_STATE.hits + \" 次）\");\n    }\n    return;\n  }\n\n  C_STATE.repathT -= dt;\n  if (C_STATE.repathT <= 0) {\n    C_STATE.repathT = C_CFG.repath;\n    // A* 寻路（文档 §2.9）：每 0.4 秒重算一次，中间交给 bwe.nav.follow 推进。\n    var path = bwe.nav.find(me.pos, target.pos, { diagonal: true, maxNodes: 2000 });\n    if (path && path.length > 1) {\n      bwe.nav.follow(me, path, { speed: C_CFG.speed });\n      C_STATE.following = true;\n    } else {\n      // 没有可行路径（例如被墙围住）：直接朝玩家走，至少不会站着不动。\n      bwe.nav.stop(me);\n      C_STATE.following = false;\n      walkToward(me, target, dt);\n    }\n  } else if (!C_STATE.following) {\n    walkToward(me, target, dt);\n  }\n}\n\nfunction walkToward(me, target, dt) {\n  var dx = target.x - me.x;\n  var dy = target.y - me.y;\n  var len = Math.sqrt(dx * dx + dy * dy);\n  if (len < 1) return;\n  me.setPos(me.x + (dx / len) * C_CFG.speed * dt, me.y + (dy / len) * C_CFG.speed * dt);\n}\n\nfunction onDamage(ctx, amount, from) {\n  bwe.log(\"[脚本] 追击怪受击 -\" + Math.round(amount));\n}\n\nfunction onDeath(ctx, by) {\n  var me = ctx.self;\n  var x = me ? me.x : 0;\n  var y = me ? me.y : 0;\n  bwe.world.spawn({\n    x: x,\n    y: y,\n    asset: \"金币\",\n    name: \"掉落金币\",\n    kind: \"PROP\",\n    tags: [\"金币\"],\n    z: 3,\n    halfW: 8,\n    halfH: 8\n  });\n  bwe.world.emit(\"kill\", { name: \"追击怪\" });\n  bwe.log(\"[脚本] 追击怪被击杀 → 掉落 1 金币\");\n}\n",
      "lang": "js"
    },
    "npc": {
      "name": "npc",
      "file": "npc.js",
      "source": "// npc.js —— 阿岚：玩家靠近显示交互提示，按 E 说一句话（屏幕空间对话框）。\nvar N_CFG = { radius: 78, talkTime: 3.2 };\n\nvar N_LINES = [\n  \"阿岚：北边那两只追击怪在巡逻，血条见红就退。\",\n  \"阿岚：按空格挥剑，打死它们会掉金币。\",\n  \"阿岚：走进西边那座治疗泉能回血 —— 我只能帮你到这儿了。\"\n];\n\nvar N_STATE = { ready: false, near: false, talked: 0, timer: 0, me: null };\n\nfunction onStart(ctx) {\n  N_STATE.ready = true;\n  N_STATE.me = ctx.self;\n  // 交互键与回调（文档 §2.9）：trigger 只在「引擎认定的最近交互物」上触发，\n  // 所以每帧还要用 bwe.interact.nearest() 把这个目标告诉引擎（见 onUpdate）。\n  bwe.interact.setKey(\"KeyE\");\n  bwe.interact.onTrigger(function (target, actor) {\n    if (target && N_STATE.me && target.id !== N_STATE.me.id) return;\n    talk();\n  });\n  bwe.log(\"[脚本] npc ready：靠近后按 E 说话\");\n}\n\nfunction talk() {\n  N_STATE.timer = N_CFG.talkTime;\n  var line = N_LINES[N_STATE.talked % N_LINES.length];\n  N_STATE.talked += 1;\n  bwe.log(\"[脚本] npc 对话：\" + line);\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self || N_STATE.me;\n  if (!N_STATE.ready || !me) return;\n  var player = bwe.world.find({ tag: \"玩家\" });\n  if (player) {\n    // nearest() 同时决定「提示画在谁头上」和「按 E 触发谁」，这一步不能省。\n    var target = bwe.interact.nearest(player, { radius: N_CFG.radius, tag: \"可交互\" });\n    var near = !!target && target.id === me.id;\n    if (near && !N_STATE.near) {\n      N_STATE.near = true;\n      bwe.interact.prompt(\"按 E 与阿岚对话\");\n    } else if (!near && N_STATE.near) {\n      N_STATE.near = false;\n      bwe.interact.prompt(null);\n    }\n  }\n  if (N_STATE.timer > 0) {\n    N_STATE.timer -= dt;\n    var line = N_LINES[(N_STATE.talked - 1 + N_LINES.length) % N_LINES.length];\n    // bwe.draw 默认就是屏幕空间（左上原点，逻辑像素，文档 §2.6）\n    bwe.draw.rect(24, 596, 640, 78, { fill: \"#0d1624\", stroke: \"#3d5a86\", width: 2, radius: 10, alpha: 0.94 });\n    bwe.draw.text(42, 616, line, { size: 16, color: \"#e8f1ff\" });\n    bwe.draw.text(42, 644, \"（按 E 继续）\", { size: 12, color: \"#89a4c9\" });\n  }\n}\n",
      "lang": "js"
    },
    "hud": {
      "name": "hud",
      "file": "hud.js",
      "source": "// hud.js —— 屏幕 HUD：血条、金币、击杀数、操作提示、FPS（全部走 bwe.draw，文档 §2.6）。\nvar HUD_STATE = { ready: false, gold: 0, kills: 0, frame: 0, fps: 0 };\n\nfunction onStart(ctx) {\n  HUD_STATE.ready = true;\n  // 初始值来自存档；之后靠事件总线增量更新（文档 §2.1 world.on / emit）\n  HUD_STATE.gold = Number(bwe.save.get(\"gold\", 0)) || 0;\n  HUD_STATE.kills = Number(bwe.save.get(\"kills\", 0)) || 0;\n  bwe.world.on(\"gold\", function (p) {\n    if (p && typeof p.gold === \"number\") HUD_STATE.gold = p.gold;\n  });\n  bwe.world.on(\"kill\", function () {\n    HUD_STATE.kills += 1;\n  });\n  bwe.log(\"[脚本] hud ready：血条 / 金币 / 击杀 / FPS\");\n}\n\nfunction onUpdate(ctx, dt) {\n  if (!HUD_STATE.ready) return;\n  HUD_STATE.frame += 1;\n  HUD_STATE.fps = dt > 0 ? Math.round(1 / dt) : 0;\n  drawHud();\n  if (HUD_STATE.frame % 120 === 0) {\n    bwe.log(\"[脚本] hud ticked：\" + HUD_STATE.frame + \" 帧，FPS \" + HUD_STATE.fps);\n  }\n}\n\nfunction drawHud() {\n  var player = bwe.world.find({ tag: \"玩家\" });\n  var hp = player ? player.hp : 0;\n  var hpMax = player ? player.hpMax : 1;\n  if (!(hpMax > 0)) hpMax = 1;\n  var pct = Math.max(0, Math.min(1, hp / hpMax));\n\n  bwe.draw.rect(16, 16, 272, 106, { fill: \"#0b1420\", stroke: \"#31465f\", radius: 8, alpha: 0.9 });\n  bwe.draw.text(30, 26, \"生命\", { size: 12, color: \"#93aecb\" });\n  bwe.draw.text(274, 26, Math.round(Math.max(0, hp)) + \" / \" + Math.round(hpMax), {\n    size: 12,\n    color: \"#cfe0f5\",\n    align: \"right\"\n  });\n  bwe.draw.bar(30, 44, 244, 14, pct, { bg: \"#1b2739\", fg: \"#3ddc84\", border: \"#0a111b\" });\n  bwe.draw.text(30, 70, \"金币 \" + HUD_STATE.gold, { size: 14, color: \"#ffd24a\" });\n  bwe.draw.text(148, 70, \"击杀 \" + HUD_STATE.kills, { size: 14, color: \"#ff9a6a\" });\n  bwe.draw.text(30, 98, \"WASD 移动 · 空格挥剑 · E 交互\", { size: 11, color: \"#7f97b6\" });\n  bwe.draw.text(274, 98, \"FPS \" + HUD_STATE.fps, { size: 11, color: \"#7f97b6\", align: \"right\" });\n}\n",
      "lang": "js"
    },
    "zone": {
      "name": "zone",
      "file": "zone.js",
      "source": "// zone.js —— 治疗泉触发区：玩家走进来就回血（触发区对象上的 onEnter/onLeave + 每帧兜底）。\nvar Z_CFG = { healPerSecond: 4, radius: 92 };\n\nvar Z_STATE = { ready: false, inside: false, me: null };\n\nfunction onStart(ctx) {\n  Z_STATE.ready = true;\n  Z_STATE.me = ctx.self;\n  bwe.log(\"[脚本] zone ready：治疗泉（走进来每秒回 \" + Z_CFG.healPerSecond + \" 血）\");\n}\n\nfunction onEnter(ctx, other) {\n  if (!isPlayer(other)) return;\n  bwe.log(\"[脚本] 触发区 onEnter：玩家进入治疗泉\");\n}\n\nfunction onLeave(ctx, other) {\n  if (!isPlayer(other)) return;\n  bwe.log(\"[脚本] 触发区 onLeave：玩家离开治疗泉\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self || Z_STATE.me;\n  var player = bwe.world.find({ tag: \"玩家\" });\n  if (!Z_STATE.ready || !me || !player) return;\n  // 每帧用距离兜底：即使 onEnter/onLeave 没派发，回血逻辑也照样工作。\n  var inside = me.distanceTo(player) <= Z_CFG.radius;\n  if (inside !== Z_STATE.inside) {\n    Z_STATE.inside = inside;\n    bwe.log(inside ? \"[脚本] 玩家在治疗泉里回血\" : \"[脚本] 玩家离开治疗泉，停止回血\");\n  }\n  if (inside) player.heal(Z_CFG.healPerSecond * dt);\n}\n\nfunction isPlayer(e) {\n  if (!e || !e.tags) return false;\n  var tags = e.tags;\n  if (typeof tags.includes === \"function\") return tags.includes(\"玩家\");\n  if (typeof tags.has === \"function\") return tags.has(\"玩家\");\n  return false;\n}\n",
      "lang": "js"
    },
    "system": {
      "name": "system",
      "file": "system.js",
      "source": "// system.js —— 场景脚本（scene.onStartScript）：建 tilemap、读档、事件总线计击杀、定时刷怪。\nvar SYS_STATE = { ready: false, kills: 0, gold: 0, spawner: null, tick: 0 };\n\nfunction onSceneStart(ctx) {\n  SYS_STATE.ready = true;\n  buildTilemap();\n\n  SYS_STATE.kills = Number(bwe.save.get(\"kills\", 0)) || 0;\n  SYS_STATE.gold = Number(bwe.save.get(\"gold\", 0)) || 0;\n  bwe.log(\"[脚本] system ready：读档 gold=\" + SYS_STATE.gold + \" kills=\" + SYS_STATE.kills);\n\n  // 事件总线统计击杀（chaser.js 死亡时 emit(\"kill\")）\n  bwe.world.on(\"kill\", function (p) {\n    SYS_STATE.kills += 1;\n    bwe.save.set(\"kills\", SYS_STATE.kills);\n    bwe.log(\"[脚本] 击杀计数：\" + SYS_STATE.kills + (p && p.name ? \"（\" + p.name + \"）\" : \"\"));\n  });\n\n  // 心跳：每秒一行日志，验证 bwe.every 与每帧循环都在跑\n  bwe.every(1, function () {\n    SYS_STATE.tick += 1;\n    bwe.save.set(\"playedSeconds\", SYS_STATE.tick);\n    bwe.log(\"[脚本] system ticked：\" + SYS_STATE.tick + \" 秒\");\n  });\n\n  // 刷怪（文档 §2.9）：右上角荒地每 6 秒补一只追击怪，最多同时 4 只\n  SYS_STATE.spawner = bwe.spawner.create({\n    script: \"chaser\",\n    count: 4,\n    interval: 6,\n    max: 4,\n    area: { x: 960, y: 96, w: 224, h: 224 },\n    onSpawn: function (e) {\n      bwe.log(\"[脚本] 刷出追击怪：\" + (e && e.name ? e.name : \"?\"));\n    }\n  });\n  bwe.log(\"[脚本] system spawner 已启动\");\n}\n\nfunction onSceneEnd(ctx) {\n  bwe.save.write(\"auto\");\n  bwe.log(\"[脚本] system 存档已写出（saves/auto.json）\");\n}\n\n/**\n * 用场景里的墙体对象建瓦片地图：脚本显式登记，A* 就不用依赖运行时是否自动识别 TILE。\n * 墙体对象都打了 tags:[\"墙体\"]，这里按标签找，与 kind 无关。\n */\nfunction buildTilemap() {\n  bwe.tilemap.setSolid(1, true);\n  var walls = bwe.world.findAll({ tag: \"墙体\" }) || [];\n  for (var i = 0; i < walls.length; i++) {\n    var cell = bwe.grid.toCell(walls[i].x, walls[i].y);\n    bwe.tilemap.set(cell.cx, cell.cy, 1);\n  }\n  bwe.log(\"[脚本] tilemap 建好：阻挡 \" + walls.length + \" 格\");\n}\n",
      "lang": "js"
    }
  },
  "variables": {
    "玩家.速度": "190",
    "玩家.攻击力": "12",
    "追击怪.速度": "92",
    "追击怪.血量": "36"
  },
  "masterVolume": 0.8
}
