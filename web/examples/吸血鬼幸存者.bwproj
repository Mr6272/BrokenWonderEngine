  "packs": [],
  "scripts": {
    "player": {
      "name": "player",
      "file": "player.js",
      "source": "\n// player.js —— 玩家：WASD 走位、武器自动开火、接触伤害、拾取经验、升级选强化、死亡/重开。\n// 全局状态都放在「玩家」实体的 props 上：其它脚本（enemy/bullet/director/hud）靠 bwe.world.find(\"玩家\")\n// 读同一份数据，不需要跨脚本共享变量（每个脚本是独立作用域，见 docs/scripting-api.md §1）。\nvar P_CFG = {\n  speed: 172,\n  half: 12,\n  // 射程要比刷怪半径短：否则怪一出生就被点掉，贴不到身上，「被围住」的压力就没了\n  fireRange: 330,\n  bulletSpeed: 540,\n  contactDps: 16,\n  gemRadius: 30\n};\n\nfunction onStart(ctx) {\n  var me = ctx.self;\n  var map = bwe.world.mapSize();\n  P_SET(me, \"hp\", 100);\n  P_SET(me, \"hpMax\", 100);\n  P_SET(me, \"level\", 1);\n  P_SET(me, \"xp\", 0);\n  P_SET(me, \"xpNext\", 5);\n  P_SET(me, \"kills\", 0);\n  P_SET(me, \"dmg\", 9);\n  P_SET(me, \"rate\", 0.62);\n  P_SET(me, \"count\", 1);\n  P_SET(me, \"speed\", P_CFG.speed);\n  P_SET(me, \"time\", 0);\n  P_SET(me, \"over\", 0);\n  P_SET(me, \"paused\", 0);\n  P_SET(me, \"menu\", \"\");\n  P_SET(me, \"pick\", 0);\n  P_SET(me, \"flash\", 0);\n  P_SET(me, \"mapW\", map.w);\n  P_SET(me, \"mapH\", map.h);\n  P_SET(me, \"fireCd\", 0);\n  bwe.camera.follow(me, { smooth: 0.14, lookAhead: 26 });\n  bwe.camera.bounds({ x: 0, y: 0, w: map.w, h: map.h });\n  bwe.log(\"[吸血鬼] player ready：WASD 移动，武器自动开火\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (P_NUM(me, \"over\") > 0) return;\n  if (P_NUM(me, \"paused\") > 0) {\n    // 升级菜单没人选就自动选第一项（示例默认手感：不停游戏；想手动选就按 1/2/3）\n    var wait = P_NUM(me, \"pauseT\") + dt;\n    P_SET(me, \"pauseT\", wait);\n    if (wait >= 5) {\n      bwe.log(\"[吸血鬼] 升级菜单 5 秒未选择，自动选第一个\");\n      applyUpgrade(me, 0);\n      P_SET(me, \"pauseT\", 0);\n    }\n    return;\n  }\n  P_SET(me, \"pauseT\", 0);\n\n  P_SET(me, \"time\", P_NUM(me, \"time\") + dt);\n  if (P_NUM(me, \"flash\") > 0) P_SET(me, \"flash\", Math.max(0, P_NUM(me, \"flash\") - dt));\n\n  move(me, dt);\n  autoFire(me, dt);\n  contactDamage(me, dt);\n  collectGems(me);\n\n  if (P_NUM(me, \"hp\") <= 0 && P_NUM(me, \"over\") === 0) {\n    P_SET(me, \"over\", 1);\n    bwe.log(\"[吸血鬼] 游戏结束：存活 \" + Math.floor(P_NUM(me, \"time\")) + \" 秒，击杀 \" + P_NUM(me, \"kills\") + \"，等级 \" + P_NUM(me, \"level\"));\n    bwe.world.emit(\"gameover\", {});\n  }\n}\n\nfunction move(me, dt) {\n  var axis = bwe.input.axis();\n  if (!axis || (axis.x === 0 && axis.y === 0)) return;\n  var sp = P_NUM(me, \"speed\");\n  var h = P_CFG.half;\n  var nx = me.x + axis.x * sp * dt;\n  var ny = me.y + axis.y * sp * dt;\n  if (!bwe.tilemap.blocked(nx - h, me.y - h, h * 2, h * 2)) me.setPos(nx, me.y);\n  if (!bwe.tilemap.blocked(me.x - h, ny - h, h * 2, h * 2)) me.setPos(me.x, ny);\n  var mw = P_NUM(me, \"mapW\");\n  var mh = P_NUM(me, \"mapH\");\n  var cx = Math.max(h, Math.min(mw - h, me.x));\n  var cy = Math.max(h, Math.min(mh - h, me.y));\n  if (cx !== me.x || cy !== me.y) me.setPos(cx, cy);\n}\n\nfunction autoFire(me, dt) {\n  // 冷却存在 props 里：Entity 包装对象不适合挂任意 JS 属性（换脚本/重建包装会丢）\n  var cd = P_NUM(me, \"fireCd\") - dt;\n  if (cd > 0) {\n    P_SET(me, \"fireCd\", cd);\n    return;\n  }\n  var target = nearestEnemy(me, P_CFG.fireRange);\n  if (!target) {\n    P_SET(me, \"fireCd\", 0.1);\n    return;\n  }\n  P_SET(me, \"fireCd\", Math.max(0.11, P_NUM(me, \"rate\")));\n  var count = Math.max(1, Math.min(6, P_NUM(me, \"count\")));\n  var base = Math.atan2(target.y - me.y, target.x - me.x);\n  var spread = 0.16;\n  for (var i = 0; i < count; i++) {\n    var ang = base + (i - (count - 1) / 2) * spread;\n    var b = bwe.world.spawn({\n      x: me.x, y: me.y, asset: \"子弹\", name: \"bullet\",\n      kind: \"PROP\", tags: [\"子弹\"], z: 9, halfW: 6, halfH: 6, script: \"bullet\"\n    });\n    if (!b) continue;\n    b.setProp(\"vx\", String(Math.cos(ang) * P_CFG.bulletSpeed));\n    b.setProp(\"vy\", String(Math.sin(ang) * P_CFG.bulletSpeed));\n    b.setProp(\"dmg\", String(P_NUM(me, \"dmg\")));\n    b.setProp(\"life\", \"1.15\");\n  }\n}\n\nfunction nearestEnemy(me, range) {\n  var list = bwe.world.findAll({ tag: \"敌人\" }) || [];\n  var best = null;\n  var bestD = range * range;\n  for (var i = 0; i < list.length; i++) {\n    var e = list[i];\n    if (!e || e.alive === false) continue;\n    var dx = e.x - me.x;\n    var dy = e.y - me.y;\n    var d = dx * dx + dy * dy;\n    if (d < bestD) { bestD = d; best = e; }\n  }\n  return best;\n}\n\nfunction contactDamage(me, dt) {\n  if (P_NUM(me, \"flash\") > 0) return;\n  var list = bwe.world.findAll({ tag: \"敌人\" }) || [];\n  var touching = 0;\n  for (var i = 0; i < list.length; i++) {\n    var e = list[i];\n    if (!e || e.alive === false) continue;\n    if (me.distanceTo(e) <= 26) touching++;\n  }\n  if (touching <= 0) return;\n  var dmg = touching * P_CFG.contactDps * dt;\n  var hp = Math.max(0, P_NUM(me, \"hp\") - dmg);\n  P_SET(me, \"hp\", hp);\n  P_SET(me, \"flash\", 0.12);\n  bwe.camera.shake(2.2, 0.08);\n  if (P_NUM(me, \"firstHit\") === 0) {\n    P_SET(me, \"firstHit\", 1);\n    bwe.log(\"[吸血鬼] 首次受击：怪物贴上来了\");\n  }\n  // 血量里程碑各报一次（验证用，也给玩家一点压力反馈）\n  if (hp < 70 && P_NUM(me, \"m70\") === 0) { P_SET(me, \"m70\", 1); bwe.log(\"[吸血鬼] 血量告急：< 70\"); }\n  if (hp < 40 && P_NUM(me, \"m40\") === 0) { P_SET(me, \"m40\", 1); bwe.log(\"[吸血鬼] 血量危险：< 40\"); }\n  if (hp < 20 && P_NUM(me, \"m20\") === 0) { P_SET(me, \"m20\", 1); bwe.log(\"[吸血鬼] 濒死：< 20\"); }\n}\n\nfunction collectGems(me) {\n  var gems = bwe.world.findAll({ tag: \"宝石\" }) || [];\n  var got = 0;\n  for (var i = 0; i < gems.length; i++) {\n    var g = gems[i];\n    if (!g || g.alive === false) continue;\n    if (me.distanceTo(g) > P_CFG.gemRadius) continue;\n    bwe.world.destroy(g);\n    got += 1;\n  }\n  if (got <= 0) return;\n  var xp = P_NUM(me, \"xp\") + got;\n  P_SET(me, \"xp\", xp);\n  var next = P_NUM(me, \"xpNext\");\n  if (xp >= next) levelUp(me);\n}\n\nfunction levelUp(me) {\n  var level = P_NUM(me, \"level\") + 1;\n  var xp = P_NUM(me, \"xp\") - P_NUM(me, \"xpNext\");\n  var next = Math.round(P_NUM(me, \"xpNext\") * 1.45 + 2);\n  P_SET(me, \"level\", level);\n  P_SET(me, \"xp\", xp);\n  P_SET(me, \"xpNext\", next);\n  // 三选一：从候选池里按等级轮转出三条（不引随机，保证可复现）\n  var pool = [\"攻击 +25%\", \"攻速 +18%\", \"弹数 +1\", \"移速 +14\", \"最大生命 +25\"];\n  var a = (level * 1) % pool.length;\n  var b = (level * 2 + 1) % pool.length;\n  var c = (level * 3 + 2) % pool.length;\n  if (b === a) b = (b + 1) % pool.length;\n  if (c === a || c === b) c = (c + 1) % pool.length;\n  P_SET(me, \"menu\", pool[a] + \"|\" + pool[b] + \"|\" + pool[c]);\n  P_SET(me, \"paused\", 1);\n  bwe.log(\"[吸血鬼] 升级 → \" + level + \" 级，等待选择强化\");\n}\n\nfunction onKey(ctx, key) {\n  var me = ctx.self;\n  var code = String(key);\n  // 升级菜单：1/2/3 选择\n  if (P_NUM(me, \"paused\") > 0) {\n    var idx = -1;\n    if (code === \"49\" || code === \"KEY_1\" || code === \"1\") idx = 0;\n    else if (code === \"50\" || code === \"KEY_2\" || code === \"2\") idx = 1;\n    else if (code === \"51\" || code === \"KEY_3\" || code === \"3\") idx = 2;\n    if (idx >= 0) applyUpgrade(me, idx);\n    return;\n  }\n  // 死亡后按 R 重开\n  if (P_NUM(me, \"over\") > 0 && (code === \"82\" || code === \"KEY_R\" || code === \"r\")) {\n    restart(me);\n  }\n}\n\nfunction applyUpgrade(me, idx) {\n  var menu = String(me.prop(\"menu\", \"\"));\n  var parts = menu.split(\"|\");\n  var pick = parts[idx] || parts[0] || \"\";\n  if (pick.indexOf(\"攻击\") >= 0) {\n    P_SET(me, \"dmg\", Math.round(P_NUM(me, \"dmg\") * 1.25 * 10) / 10);\n  } else if (pick.indexOf(\"攻速\") >= 0) {\n    P_SET(me, \"rate\", Math.max(0.12, P_NUM(me, \"rate\") * 0.82));\n  } else if (pick.indexOf(\"弹数\") >= 0) {\n    P_SET(me, \"count\", Math.min(6, P_NUM(me, \"count\") + 1));\n  } else if (pick.indexOf(\"移速\") >= 0) {\n    P_SET(me, \"speed\", P_NUM(me, \"speed\") + 14);\n  } else if (pick.indexOf(\"生命\") >= 0) {\n    P_SET(me, \"hpMax\", P_NUM(me, \"hpMax\") + 25);\n    P_SET(me, \"hp\", Math.min(P_NUM(me, \"hpMax\"), P_NUM(me, \"hp\") + 25));\n  }\n  P_SET(me, \"menu\", \"\");\n  P_SET(me, \"paused\", 0);\n  bwe.log(\"[吸血鬼] 选择强化：\" + pick);\n}\n\nfunction restart(me) {\n  P_SET(me, \"hp\", 100);\n  P_SET(me, \"hpMax\", 100);\n  P_SET(me, \"level\", 1);\n  P_SET(me, \"xp\", 0);\n  P_SET(me, \"xpNext\", 5);\n  P_SET(me, \"kills\", 0);\n  P_SET(me, \"dmg\", 9);\n  P_SET(me, \"rate\", 0.62);\n  P_SET(me, \"count\", 1);\n  P_SET(me, \"speed\", P_CFG.speed);\n  P_SET(me, \"time\", 0);\n  P_SET(me, \"over\", 0);\n  P_SET(me, \"paused\", 0);\n  P_SET(me, \"menu\", \"\");\n  var junk = bwe.world.findAll(\"敌人\");\n  for (var i = 0; i < junk.length; i++) bwe.world.destroy(junk[i]);\n  var gems = bwe.world.findAll({ tag: \"宝石\" }) || [];\n  for (var j = 0; j < gems.length; j++) bwe.world.destroy(gems[j]);\n  var bullets = bwe.world.findAll({ tag: \"子弹\" }) || [];\n  for (var k = 0; k < bullets.length; k++) bwe.world.destroy(bullets[k]);\n  me.setPos(P_NUM(me, \"mapW\") / 2, P_NUM(me, \"mapH\") / 2);\n  bwe.log(\"[吸血鬼] 重开\");\n}\n\n// ---- props 读写的小工具 ----\nfunction P_SET(e, key, value) { e.setProp(key, String(value)); }\nfunction P_NUM(e, key) { var v = Number(e.prop(key, \"0\")); return isFinite(v) ? v : 0; }\n",
      "lang": "js"
    },
    "enemy": {
      "name": "enemy",
      "file": "enemy.js",
      "source": "\n// enemy.js —— 追击型敌人：朝玩家直线移动（有墙角就沿墙滑），贴身由玩家脚本结算伤害。\n// 死亡（被子弹打死）时掉一颗经验宝石。\nvar E_STATE = { bob: 0 };\n\nfunction onStart(ctx) {\n  var e = ctx.self;\n  E_STATE[e.id] = { t: (Number(e.prop(\"seed\", \"0\")) % 100) / 100 };\n  // 注意：导演是 spawn 之后才 setProp 的，onStart 可能先跑，所以血量初始化放到第一次 onUpdate。\n  applyStats(e);\n}\n\n/** 把导演写进 props 的数值应用到引擎血量上（只做一次）。 */\nfunction applyStats(e) {\n  if (Number(e.prop(\"inited\", \"0\")) > 0) return;\n  var hp = Number(e.prop(\"hpInit\", \"18\"));\n  if (!isFinite(hp) || hp <= 0) hp = 18;\n  e.hpMax = hp;\n  e.hp = hp;\n  e.setProp(\"inited\", \"1\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var e = ctx.self;\n  applyStats(e);\n  var player = bwe.world.find(\"玩家\");\n  if (!player) return;\n  if (Number(player.prop(\"paused\", \"0\")) > 0 || Number(player.prop(\"over\", \"0\")) > 0) return;\n\n  var sp = Number(e.prop(\"speed\", \"64\"));\n  var dx = player.x - e.x;\n  var dy = player.y - e.y;\n  var dist = Math.sqrt(dx * dx + dy * dy) || 1;\n  if (dist < 18) return; // 贴脸就停，避免抖动\n\n  // 每个敌人带一点切向偏移，走成扇形而不是一条线（避免全叠在一起）\n  var st = E_STATE[e.id] || { t: 0 };\n  st.t = (st.t || 0) + dt * 0.8;\n  var side = Math.sin(st.t + (e.x % 7)) * 0.45;\n  var nx = dx / dist - (dy / dist) * side;\n  var ny = dy / dist + (dx / dist) * side;\n  var len = Math.sqrt(nx * nx + ny * ny) || 1;\n  var stepX = (nx / len) * sp * dt;\n  var stepY = (ny / len) * sp * dt;\n  var h = 11;\n  if (!bwe.tilemap.blocked(e.x + stepX - h, e.y - h, h * 2, h * 2)) e.x = e.x + stepX;\n  if (!bwe.tilemap.blocked(e.x - h, e.y + stepY - h, h * 2, h * 2)) e.y = e.y + stepY;\n}\n\nfunction onDeath(ctx) {\n  var e = ctx.self;\n  bwe.world.spawn({\n    x: e.x, y: e.y, asset: \"经验\", name: \"gem\", kind: \"PROP\",\n    tags: [\"宝石\"], z: 3, halfW: 7, halfH: 7, script: \"gem\"\n  });\n  var player = bwe.world.find(\"玩家\");\n  if (player) {\n    var kills = Number(player.prop(\"kills\", \"0\")) + 1;\n    player.setProp(\"kills\", String(kills));\n    if (kills % 10 === 0) bwe.log(\"[吸血鬼] 击杀 \" + kills);\n  }\n}\n",
      "lang": "js"
    },
    "bullet": {
      "name": "bullet",
      "file": "bullet.js",
      "source": "\n// bullet.js —— 玩家子弹：直线飞行，命中最近的敌人就结算伤害并消失。\nvar B_LIFE = 1.2;\n\nfunction onUpdate(ctx, dt) {\n  var b = ctx.self;\n  var vx = Number(b.prop(\"vx\", \"0\"));\n  var vy = Number(b.prop(\"vy\", \"0\"));\n  var life = Number(b.prop(\"life\", \"1.2\")) - dt;\n  if (life <= 0) { bwe.world.destroy(b); return; }\n  b.setProp(\"life\", String(life));\n  b.x = b.x + vx * dt;\n  b.y = b.y + vy * dt;\n\n  if (bwe.tilemap.blocked(b.x - 4, b.y - 4, 8, 8)) { bwe.world.destroy(b); return; }\n\n  var list = bwe.world.findAll({ tag: \"敌人\" }) || [];\n  var dmg = Number(b.prop(\"dmg\", \"9\"));\n  for (var i = 0; i < list.length; i++) {\n    var e = list[i];\n    if (!e || e.alive === false) continue;\n    if (b.distanceTo(e) <= 20) {\n      e.damage(dmg);\n      bwe.world.destroy(b);\n      return;\n    }\n  }\n}\n",
      "lang": "js"
    },
    "gem": {
      "name": "gem",
      "file": "gem.js",
      "source": "\n// gem.js —— 经验宝石：玩家靠近就被「吸」过去（幸存者类游戏的手感关键），掉太久会自动消失。\nvar G_MAGNET = 190;   // 吸附半径\nvar G_SPEED = 260;    // 吸附速度\nvar G_LIFE = 22;      // 存在时间（秒）\n\nfunction onStart(ctx) {\n  ctx.self.setProp(\"life\", String(G_LIFE));\n}\n\nfunction onUpdate(ctx, dt) {\n  var g = ctx.self;\n  var life = Number(g.prop(\"life\", String(G_LIFE))) - dt;\n  if (life <= 0) { bwe.world.destroy(g); return; }\n  g.setProp(\"life\", String(life));\n\n  var p = bwe.world.find(\"玩家\");\n  if (!p) return;\n  var dx = p.x - g.x;\n  var dy = p.y - g.y;\n  var d = Math.sqrt(dx * dx + dy * dy);\n  if (d < 1 || d > G_MAGNET) return;\n  var step = Math.min(d, G_SPEED * dt);\n  g.x = g.x + (dx / d) * step;\n  g.y = g.y + (dy / d) * step;\n}\n",
      "lang": "js"
    },
    "director": {
      "name": "director",
      "file": "director.js",
      "source": "\n// director.js —— 场景导演：计时、刷怪节奏、难度曲线、清理离屏子弹。\n// 引擎只负责「刷出来」，怪怎么追由 enemy.js 决定；难度用 props 传给新怪。\nvar D_STATE = { t: 0, wave: 0, nextWave: 0, aliveCap: 150, dbg: 0 };\n\nfunction onSceneStart(ctx) {\n  bwe.seed.set(20261027);\n  D_STATE.t = 0;\n  D_STATE.wave = 0;\n  D_STATE.nextWave = 0.6;\n  bwe.log(\"[吸血鬼] 开始：在暗夜里活下去（WASD 移动 · 武器自动开火 · 1/2/3 选强化 · R 重开）\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var player = bwe.world.find(\"玩家\");\n  if (!player) return;\n  var paused = Number(player.prop(\"paused\", \"0\")) > 0;\n  var over = Number(player.prop(\"over\", \"0\")) > 0;\n  if (paused || over) return;\n\n  D_STATE.t += dt;\n  // 每 5 秒打一行诊断（示例里保留：调平衡/看压力时很有用，日志量也可控）\n  D_STATE.dbg = (D_STATE.dbg || 0) + dt;\n  if (D_STATE.dbg >= 5) {\n    D_STATE.dbg = 0;\n    var foes = bwe.world.findAll({ tag: \"敌人\" }) || [];\n    var nearest = 9999;\n    for (var q = 0; q < foes.length; q++) {\n      var fd = Math.sqrt((foes[q].x - player.x) * (foes[q].x - player.x) + (foes[q].y - player.y) * (foes[q].y - player.y));\n      if (fd < nearest) nearest = fd;\n    }\n    bwe.log(\"[吸血鬼] 诊断 t=\" + Math.floor(D_STATE.t) + \"s 敌人=\" + foes.length + \" 最近=\" + Math.round(nearest) + \" 血量=\" + Math.round(Number(player.prop(\"hp\", \"0\"))));\n  }\n  D_STATE.nextWave -= dt;\n  if (D_STATE.nextWave > 0) return;\n  D_STATE.wave += 1;\n  var minute = D_STATE.t / 60;\n  D_STATE.nextWave = Math.max(0.6, 2.0 - minute * 0.35);\n\n  var count = 2 + Math.floor(D_STATE.wave / 3) + Math.floor(minute * 2);\n  var hpScale = 1 + minute * 0.55;\n  var spScale = 1 + minute * 0.18;\n  var alive = (bwe.world.findAll({ tag: \"敌人\" }) || []).length;\n  if (alive >= D_STATE.aliveCap) return;\n\n  var mapW = Number(player.prop(\"mapW\", \"1408\"));\n  var mapH = Number(player.prop(\"mapH\", \"1088\"));\n  for (var i = 0; i < count && alive + i < D_STATE.aliveCap; i++) {\n    var ang = (i / count) * Math.PI * 2 + D_STATE.wave * 0.7;\n    var radius = 520 + (i % 3) * 40; // 在射程(330)之外出生，走过来才有压迫感\n    var x = Math.max(40, Math.min(mapW - 40, player.x + Math.cos(ang) * radius));\n    var y = Math.max(40, Math.min(mapH - 40, player.y + Math.sin(ang) * radius));\n    var brute = D_STATE.wave % 5 === 0 && i === 0;\n    var e = bwe.world.spawn({\n      x: x, y: y,\n      asset: brute ? \"大怪\" : \"敌人\",\n      name: brute ? \"精英\" : \"蝙蝠\",\n      kind: \"ACTOR\", tags: [\"敌人\"], z: 5,\n      halfW: brute ? 18 : 12, halfH: brute ? 18 : 12,\n      script: \"enemy\"\n    });\n    if (!e) continue;\n    e.setProp(\"speed\", String(Math.round((brute ? 50 : 72) * spScale)));\n    e.setProp(\"hpInit\", String(Math.round((brute ? 70 : 18) * hpScale)));\n    e.setProp(\"seed\", String(D_STATE.wave * 7 + i));\n    if (brute) bwe.log(\"[吸血鬼] 精英出现（第 \" + D_STATE.wave + \" 波）\");\n  }\n  if (D_STATE.wave % 10 === 0) {\n    bwe.log(\"[吸血鬼] 第 \" + D_STATE.wave + \" 波：场上 \" + alive + \" 只，难度 x\" + (1 + minute * 0.55).toFixed(2));\n  }\n\n  // 清理飞太远的子弹（防止对象无限增长）\n  var bullets = bwe.world.findAll({ tag: \"子弹\" }) || [];\n  for (var j = 0; j < bullets.length; j++) {\n    var b = bullets[j];\n    if (!b) continue;\n    if (b.x < -60 || b.y < -60 || b.x > mapW + 60 || b.y > mapH + 60) bwe.world.destroy(b);\n  }\n}\n",
      "lang": "js"
    },
    "hud": {
      "name": "hud",
      "file": "hud.js",
      "source": "\n// hud.js —— 屏幕 HUD：血条 / 经验条 / 计时 / 击杀 / 等级 / 武器数值 / 升级三选一 / 结算画面。\n// 全部用 bwe.draw（立即模式，屏幕空间），不依赖 UI 组件。\nfunction onUpdate(ctx, dt) {\n  var p = bwe.world.find(\"玩家\");\n  if (!p) return;\n\n  var hp = Number(p.prop(\"hp\", \"0\"));\n  var hpMax = Number(p.prop(\"hpMax\", \"100\"));\n  var xp = Number(p.prop(\"xp\", \"0\"));\n  var xpNext = Number(p.prop(\"xpNext\", \"5\"));\n  var level = Number(p.prop(\"level\", \"1\"));\n  var kills = Number(p.prop(\"kills\", \"0\"));\n  var t = Number(p.prop(\"time\", \"0\"));\n  var over = Number(p.prop(\"over\", \"0\")) > 0;\n  var paused = Number(p.prop(\"paused\", \"0\")) > 0;\n  var enemies = (bwe.world.findAll({ tag: \"敌人\" }) || []).length;\n  var dmg = Number(p.prop(\"dmg\", \"9\"));\n  var rate = Number(p.prop(\"rate\", \"0.62\"));\n  var count = Number(p.prop(\"count\", \"1\"));\n\n  // ---- 左上：血条 ----\n  var w = 250;\n  bwe.draw.text(20, 18, \"HP \" + Math.ceil(hp) + \" / \" + Math.round(hpMax), { size: 14, color: \"#ffd9d9\" });\n  bwe.draw.bar(20, 26, w, 14, hp / Math.max(1, hpMax), { bg: \"#2a1620\", fg: \"#e5484d\", border: \"#5a2a30\" });\n  // ---- 左上：经验条 ----\n  bwe.draw.bar(20, 46, w, 8, xp / Math.max(1, xpNext), { bg: \"#16241c\", fg: \"#5ad18a\", border: \"#24402e\" });\n  bwe.draw.text(20, 58, \"LV \" + level + \"　XP \" + Math.floor(xp) + \"/\" + xpNext, { size: 12, color: \"#bfe8cf\" });\n\n  // ---- 顶部中间：存活时间 ----\n  var mm = Math.floor(t / 60);\n  var ss = Math.floor(t % 60);\n  var clock = (mm < 10 ? \"0\" : \"\") + mm + \":\" + (ss < 10 ? \"0\" : \"\") + ss;\n  bwe.draw.text(640, 20, clock, { size: 26, color: \"#f2f2f7\", align: \"center\" });\n\n  // ---- 右上：击杀 / 武器 / 场上怪 ----\n  bwe.draw.text(1260, 20, \"击杀 \" + kills, { size: 15, color: \"#ffd9a0\", align: \"right\" });\n  bwe.draw.text(1260, 42, \"武器 伤害 \" + dmg + \" · 间隔 \" + rate.toFixed(2) + \"s · 弹数 \" + count, { size: 12, color: \"#c8ccd8\", align: \"right\" });\n  bwe.draw.text(1260, 60, \"场上敌人 \" + enemies, { size: 12, color: \"#9aa0b0\", align: \"right\" });\n\n  // ---- 左下：操作提示 ----\n  bwe.draw.text(20, 700, \"WASD 移动　武器自动开火\", { size: 12, color: \"#6c7080\" });\n\n  // ---- 升级三选一 ----\n  if (paused) {\n    bwe.draw.rect(340, 250, 600, 210, { fill: \"#12121aee\", stroke: \"#3d3d52\", width: 2, radius: 8 });\n    bwe.draw.text(640, 282, \"升  级  了\", { size: 24, color: \"#ffe9a8\", align: \"center\" });\n    var menu = String(p.prop(\"menu\", \"\"));\n    var parts = menu.split(\"|\");\n    for (var i = 0; i < parts.length && i < 3; i++) {\n      var y = 330 + i * 42;\n      bwe.draw.rect(384, y - 22, 512, 34, { fill: \"#1c1c28\", stroke: \"#4a4a63\", width: 1, radius: 6 });\n      bwe.draw.text(408, y, (i + 1) + \"．\" + parts[i], { size: 17, color: \"#e6e6f0\" });\n    }\n    bwe.draw.text(640, 452, \"按 1 / 2 / 3 选择（选完继续）\", { size: 12, color: \"#8b90a0\", align: \"center\" });\n    return;\n  }\n\n  // ---- 结算 ----\n  if (over) {\n    bwe.draw.rect(340, 260, 600, 190, { fill: \"#1a0f14ee\", stroke: \"#66323a\", width: 2, radius: 8 });\n    bwe.draw.text(640, 300, \"你  倒  下  了\", { size: 28, color: \"#ff8a8a\", align: \"center\" });\n    bwe.draw.text(640, 346, \"存活 \" + clock + \"　击杀 \" + kills + \"　等级 \" + level, { size: 16, color: \"#e0c0c0\", align: \"center\" });\n    bwe.draw.text(640, 392, \"按 R 重新开始\", { size: 15, color: \"#ffd9a0\", align: \"center\" });\n  }\n}\n",
      "lang": "js"
    }
  },
  "variables": {
    "武器.伤害": "9",
    "武器.间隔": "0.62",
    "玩家.移速": "172",
    "难度.每分钟血量": "0.55"
  },
  "masterVolume": 0.8
}
