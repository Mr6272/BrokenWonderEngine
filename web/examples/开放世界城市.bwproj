,{\"x\":1504,\"y\":1880,\"heading\":180},{\"x\":1952,\"y\":1928,\"heading\":0},{\"x\":2304,\"y\":1880,\"heading\":180},{\"x\":2656,\"y\":1928,\"heading\":0},{\"x\":3008,\"y\":1880,\"heading\":180},{\"x\":3296,\"y\":1928,\"heading\":0},{\"x\":3552,\"y\":1880,\"heading\":180},{\"x\":1184,\"y\":2568,\"heading\":0},{\"x\":1504,\"y\":2520,\"heading\":180},{\"x\":1792,\"y\":2568,\"heading\":0},{\"x\":2080,\"y\":2520,\"heading\":180},{\"x\":2368,\"y\":2568,\"heading\":0},{\"x\":2656,\"y\":2520,\"heading\":180},{\"x\":3008,\"y\":2568,\"heading\":0},{\"x\":3296,\"y\":2520,\"heading\":180},{\"x\":3552,\"y\":2568,\"heading\":0}],\"parking\":[{\"x\":1288,\"y\":352,\"heading\":270},{\"x\":1080,\"y\":1760,\"heading\":90},{\"x\":1080,\"y\":1920,\"heading\":90},{\"x\":1288,\"y\":640,\"heading\":270},{\"x\":1288,\"y\":2240,\"heading\":270},{\"x\":1080,\"y\":1312,\"heading\":90},{\"x\":2880,\"y\":2368,\"heading\":90},{\"x\":2928,\"y\":2368,\"heading\":90},{\"x\":2976,\"y\":2368,\"heading\":90},{\"x\":3024,\"y\":2368,\"heading\":90},{\"x\":3072,\"y\":2368,\"heading\":90},{\"x\":3120,\"y\":2368,\"heading\":90},{\"x\":3168,\"y\":2368,\"heading\":90},{\"x\":3216,\"y\":2368,\"heading\":90}],\"lights\":[{\"node\":\"n_2\",\"x\":304,\"y\":1056},{\"node\":\"n_5\",\"x\":1184,\"y\":304},{\"node\":\"n_7\",\"x\":1184,\"y\":1056},{\"node\":\"n_9\",\"x\":1184,\"y\":1904},{\"node\":\"n_10\",\"x\":1184,\"y\":2544},{\"node\":\"n_13\",\"x\":2032,\"y\":1056},{\"node\":\"n_18\",\"x\":2736,\"y\":1056},{\"node\":\"n_23\",\"x\":3632,\"y\":1056}],\"solids\":[[241,634,12,12],[241,2234,12,12],[234,1204,12,32],[355,1274,12,12],[355,2554,12,12],[362,1204,12,32],[1064,634,12,12],[1058,1268,24,24],[1062,1592,16,16],[1064,2234,12,12],[1050,1204,12,32],[1290,632,16,16],[1290,1272,16,16],[1292,1594,12,12],[1286,2228,24,24],[1306,1204,12,32],[1969,634,12,12],[1962,1204,12,32],[2083,634,12,12],[2090,1204,12,32],[2666,1204,12,32],[2787,634,12,12],[2794,1204,12,32],[3569,1338,12,12],[3690,1908,12,32],[634,241,12,12],[158