  "packs": [],
  "scripts": {
    "world": {
      "name": "world",
      "file": "world.js",
      "source": "// world.js —— 场景脚本：铺材质、开物理、定种子、装全局钩子、每秒打点。\n// 规格见 docs/emergence-demo.md；契约见 docs/scripting-api.md §2.11。\nvar W_CFG = {\n  seed: 20261026,\n  igniteStrength: 1.0,\n  summaryEvery: 1,\n  // 场是固定步长模拟。默认 0.1s/tick 时火线每秒推进约 10 格，4 秒就把整片草地烧光，\n  // 「火→油桶→水渠」来不及交互；放慢到 0.3s/tick + 草地易燃度 0.25，\n  // 火线约 1 格/秒，一场火能烧 20+ 秒，才看得到涌现组合。\n  fieldTick: 0.3,\n  grassFlammable: 0.25,\n  grassBurnTime: 3.0\n};\n\nvar W_STATE = {\n  ready: false, t: 0, ignites: 0, burned: 0, extinguish: 0, collisions: 0, oilFired: false, brokenBottles: {},\n  // 在 onSceneStart 里按油桶位置填入；提前声明成空数组，编辑器的类型检查才认这个字段。\n  oilCells: []\n};\n\nfunction onSceneStart(ctx) {\n  W_STATE.ready = true;\n  // 确定性：同种子 + 同输入 ⇒ 同结果（材质场/物理/AI 三个随机源一起重置）\n  bwe.seed.set(W_CFG.seed);\n  bwe.field.tickRate(W_CFG.fieldTick);\n  // 草地调慢一点：默认 flammable 0.8 时相邻格几乎每个 tick 必着，火线 10 格/秒，\n  // 一场火 4 秒烧完，看不到「油桶爆燃 / 水渠切断 / 守卫赶来」这些组合。\n  bwe.material.define(\"grass\", { flammable: W_CFG.grassFlammable, burnTime: W_CFG.grassBurnTime, tags: [\"plant\", \"ground\"] });\n  paintTerrain();\n  W_STATE.oilCells = findOilCells();\n  bwe.physics.enable();\n  bwe.physics.gravity(0);\n  setupFactions();\n  hookField();\n  hookPhysics();\n  bwe.every(W_CFG.summaryEvery, function () { summary(); });\n  // 油桶爆燃：开局先记下油桶所在的格子（按 tag 找，不写死坐标），之后每 0.25 秒看它们有没有被点着。\n  // 为什么不用 field 的 ignite/burned 事件：油桶是 TILE 实体，火先烧伤实体再烧格子，\n  // 事件里的 material 可能已经是 null，靠事件判断会漏掉；轮询「原来有油、现在烧了/没了」更可靠。\n  bwe.every(0.25, function () { checkOil(); });\n  bwe.log(\"[涌现] 材质就绪：grass/wood/stone/oil/water\");\n  bwe.log(\"[涌现] 物理已开启，种子 \" + W_CFG.seed);\n}\n\n/** 材质铺法：草地（易燃）/ 水渠（灭火）/ 哨站石地（不燃）。石墙/木栅/油桶在 TILE 对象的 props.material。 */\nfunction paintTerrain() {\n  const g = { grassNorth: { x0: 2, y0: 15, x1: 37, y1: 18 },\n            grassSouthA: { x0: 2, y0: 20, x1: 21, y1: 28 },\n            grassSouthB: { x0: 24, y0: 20, x1: 36, y1: 28 },\n            channel: { x0: 22, y0: 20, x1: 23, y1: 28 },\n            pond: { x0: 18, y0: 24, x1: 19, y1: 26 },\n            flowerbed: { x0: 3, y0: 16, x1: 7, y1: 17 },\n            stationFloor: { x0: 15, y0: 6, x1: 24, y1: 12 } };\n  paintRect(g.grassNorth, \"grass\");\n  paintRect(g.grassSouthA, \"grass\");\n  paintRect(g.grassSouthB, \"grass\");\n  paintRect(g.channel, \"water\");\n  paintRect(g.pond, \"water\");\n  paintRect(g.flowerbed, \"grass\");\n  // ⚠ bwe.material.setTile 会把格子标记成\"脚本固定\"，之后 TILE 对象的材质不会覆盖它；\n  // 所以花圃的**石墙圈必须显式再刷一遍 stone**，否则一圈草会把火引进花圃（踩过）。\n  paintFlowerbedRing();\n  paintRect(g.stationFloor, \"stone\");\n  bwe.log(\"[涌现] 地形材质：草地 \" + (cellCount(g.grassNorth) + cellCount(g.grassSouthA) + cellCount(g.grassSouthB))\n    + \" 格 / 水 \" + (cellCount(g.channel) + cellCount(g.pond)) + \" 格 / 石地 \" + cellCount(g.stationFloor) + \" 格\");\n}\n\nfunction paintRect(r, mat) {\n  for (var cy = r.y0; cy <= r.y1; cy++) {\n    for (var cx = r.x0; cx <= r.x1; cx++) bwe.material.setTile(cx, cy, mat);\n  }\n}\n\nfunction cellCount(r) { return (r.x1 - r.x0 + 1) * (r.y1 - r.y0 + 1); }\n\n/** 花圃石墙圈：花圃矩形里除了内部草地之外的格子，全部刷成 stone。 */\nfunction paintFlowerbedRing() {\n  var fb = { x0: 2, y0: 15, x1: 8, y1: 18 };\n  var inside = { x0: 3, y0: 16, x1: 7, y1: 17 };\n  for (var cy = fb.y0; cy <= fb.y1; cy++) {\n    for (var cx = fb.x0; cx <= fb.x1; cx++) {\n      var inGrass = cx >= inside.x0 && cx <= inside.x1 && cy >= inside.y0 && cy <= inside.y1;\n      if (!inGrass) bwe.material.setTile(cx, cy, \"stone\");\n    }\n  }\n}\n\nfunction setupFactions() {\n  bwe.faction.relation(\"guard\", \"player\", -1);\n  bwe.faction.relation(\"guard\", \"civilian\", 0);\n  var guards = bwe.world.findAll({ tag: \"守卫\" }) || [];\n  for (var i = 0; i < guards.length; i++) bwe.faction.set(guards[i], \"guard\");\n  var player = bwe.world.find({ tag: \"玩家\" });\n  if (player) bwe.faction.set(player, \"player\");\n  var civ = bwe.world.find({ tag: \"平民\" });\n  if (civ) bwe.faction.set(civ, \"civilian\");\n}\n\n/** 场事件：烧穿木墙从引擎事件里读（不写死坐标）。 */\nfunction hookField() {\n  bwe.field.on(\"ignite\", function (ev) {\n    if (ev) W_STATE.ignites += 1;\n  });\n  bwe.field.on(\"extinguish\", function (ev) {\n    if (!ev) return;\n    W_STATE.extinguish += 1;\n    var wetNb = wetNeighbors(ev.cx, ev.cy);\n    if (wetNb > 0 && bwe.material.of(ev.cx, ev.cy) !== null) {\n      bwe.log(\"[涌现] 水渠灭火 (\" + ev.cx + \",\" + ev.cy + \")，相邻 \" + wetNb + \" 格变 wet\");\n    }\n  });\n  bwe.field.on(\"burned\", function (ev) {\n    if (!ev) return;\n    W_STATE.burned += 1;\n    // 木墙烧穿：E3 的断言依据（只给木墙专门打行，草地烧尽太常见，只在统计里计数）\n    if (ev.material === \"wood\") {\n      var open = !bwe.tilemap.solid(ev.cx, ev.cy);\n      bwe.log(\"[涌现] 木墙 (\" + ev.cx + \",\" + ev.cy + \") 烧穿，格子\" + (open ? \"已可通行\" : \"仍阻挡\"));\n    }\n    // 油桶烧尽 = 那格油被点着了 → 爆燃（实际检测在 checkOil 轮询里，见 onSceneStart）\n  });\n}\n\n/** 开局记下所有油桶格子（按 tag 找实体，不写死坐标）。 */\nfunction findOilCells() {\n  var list = bwe.world.findAll({ tag: \"油桶\" }) || [];\n  var out = [];\n  for (var i = 0; i < list.length; i++) {\n    var c = bwe.grid.toCell(list[i].x, list[i].y);\n    out.push({ cx: c.cx, cy: c.cy });\n  }\n  return out;\n}\n\n/** 油桶第一次被点着 → 爆燃：冲击波推周围可推物体 + 大范围噪音（火势暴涨的源头）。 */\nfunction checkOil() {\n  if (W_STATE.oilFired) return;\n  var cells = W_STATE.oilCells || [];\n  for (var i = 0; i < cells.length; i++) {\n    var cx = cells[i].cx;\n    var cy = cells[i].cy;\n    var burning = bwe.field.sample(\"fire\", cx, cy) > 0.05;\n    var gone = bwe.material.of(cx, cy) === null;\n    if (!burning && !gone) continue;\n    W_STATE.oilFired = true;\n    bwe.log(\"[涌现] 油桶起火 (\" + cx + \",\" + cy + \") 燃烧强度 \" + bwe.field.sample(\"fire\", cx, cy));\n    shockwave(cx, cy, 150, 120);\n    bwe.noise.emit(cx * 32 + 16, cy * 32 + 16, { radius: 900, intensity: 2.0, tag: \"explosion\" });\n    bwe.log(\"[涌现] 油桶爆燃：噪音半径 900，冲击波已推周围物体\");\n    return;\n  }\n}\n\nfunction wetNeighbors(cx, cy) {\n  var n = 0;\n  var dirs = [[1, 0], [-1, 0], [0, 1], [0, -1]];\n  for (var i = 0; i < dirs.length; i++) {\n    if (bwe.field.sample(\"water\", cx + dirs[i][0], cy + dirs[i][1]) > 0) n += 1;\n  }\n  return n;\n}\n\nfunction shockwave(cx, cy, radiusPx, impulse) {\n  var list = bwe.world.findAll({ tag: \"可推\" }) || [];\n  for (var i = 0; i < list.length; i++) {\n    var e = list[i];\n    var dx = e.x - (cx * 32 + 16);\n    var dy = e.y - (cy * 32 + 16);\n    var d = Math.sqrt(dx * dx + dy * dy);\n    if (d > radiusPx || d < 0.5) continue;\n    var k = (1 - d / radiusPx);\n    bwe.physics.applyImpulse(e, (dx / d) * impulse * k, (dy / d) * impulse * k);\n    bwe.log(\"[涌现] 冲击波 applyImpulse->\" + e.name + \" 冲量 \" + Math.round(impulse * k));\n  }\n}\n\n/** 物理碰撞：油瓶落地/撞墙 → 在落点放火（油瓶自己决定，不是引擎写死）。\n *  同一个瓶子只处理第一次碰撞：jbox2d 在贴墙静止时会反复上报接触，\n *  不设防会把「碎裂起火」刷屏，也会把同一格反复点燃。 */\nfunction hookPhysics() {\n  bwe.physics.on(\"collision\", function (ev) {\n    if (!ev) return;\n    W_STATE.collisions += 1;\n    var a = ev.a, b = ev.b;\n    var bottle = null;\n    if (a && a.tags && a.tags.includes(\"油瓶\")) bottle = a;\n    else if (b && b.tags && b.tags.includes(\"油瓶\")) bottle = b;\n    var key = bottle ? bottle.id : \"\";\n    var first = bottle && !W_STATE.brokenBottles[key];\n    bwe.log(\"[涌现] 碰撞 #\" + W_STATE.collisions + \" \" + nameOf(a) + \" x \" + nameOf(b)\n      + \" 冲量 \" + (ev.impulse ? Math.round(ev.impulse) : 0) + (first ? \"（首次）\" : \"\"));\n    if (!first) return;\n    W_STATE.brokenBottles[key] = true;\n    var cell = bwe.grid.toCell(bottle.x, bottle.y);\n    bwe.field.emit(\"fire\", cell.cx, cell.cy, 0.9);\n    bwe.log(\"[涌现] 油瓶碎裂 (\" + cell.cx + \",\" + cell.cy + \") 起火\");\n  });\n}\n\nfunction nameOf(e) { return e && e.name ? e.name : \"(静态)\"; }\n\nfunction summary() {\n  W_STATE.t += W_CFG.summaryEvery;\n  var burning = bwe.field.burning() || [];\n  var guards = bwe.world.findAll({ tag: \"守卫\" }) || [];\n  var states = [];\n  for (var i = 0; i < guards.length; i++) states.push(bwe.ai.state(guards[i]));\n  var civ = bwe.world.find({ tag: \"平民\" });\n  var noises = bwe.noise.events() || [];\n  bwe.log(\"[涌现] \" + W_STATE.t + \" 秒统计：燃烧 \" + burning.length + \" 格 / 烧毁 \" + W_STATE.burned\n    + \" 格 / 守卫状态 \" + states.join(\",\")\n    + \" / 平民 \" + (civ ? bwe.ai.state(civ) : \"-\")\n    + \" / 噪音 \" + noises.length + \" 条 / 碰撞 \" + W_STATE.collisions);\n}\n",
      "lang": "js"
    },
    "player": {
      "name": "player",
      "file": "player.js",
      "source": "// player.js —— 玩家：WASD 移动 / 空格 点火把 / F 推物体 / 鼠标左键 丢油瓶。\n// 注意：同一段脚本挂多个对象时，模块级变量是共享的；这里只有玩家一个对象，所以直接存。\nvar P_CFG = {\n  speed: 200,\n  half: 10,\n  noiseRadius: 620,\n  pushRange: 120,\n  pushImpulse: 90,\n  throwSpeed: 380\n};\n\nvar P_STATE = { ready: false, mapW: 0, mapH: 0, faceX: 0, faceY: 1, ignites: 0, pushes: 0, throws: 0 };\n\nfunction onStart(ctx) {\n  var map = bwe.world.mapSize();\n  P_STATE.mapW = map.w;\n  P_STATE.mapH = map.h;\n  bwe.camera.follow(ctx.self, { smooth: 0.25 });\n  bwe.camera.bounds({ x: 0, y: 0, w: map.w, h: map.h });\n  P_STATE.ready = true;\n  bwe.log(\"[涌现] 玩家就绪：WASD 移动 / 空格 点火 / F 推 / 左键 丢油瓶\");\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!P_STATE.ready || !me || me.alive === false) return;\n  move(me, dt);\n  if (bwe.input.pressed(\"Space\")) ignite(me);\n  if (bwe.input.pressed(\"KeyF\")) push(me);\n  if (bwe.input.pressed(\"Mouse0\")) throwBottle(me);\n}\n\nfunction move(me, dt) {\n  var ax = bwe.input.axis();\n  if (!ax || (ax.x === 0 && ax.y === 0)) return;\n  P_STATE.faceX = ax.x;\n  P_STATE.faceY = ax.y;\n  var step = P_CFG.speed * dt;\n  var nx = me.x + ax.x * step;\n  var ny = me.y + ax.y * step;\n  if (!solid(nx, me.y)) me.setPos(nx, me.y);\n  if (!solid(me.x, ny)) me.setPos(me.x, ny);\n  clamp(me);\n}\n\nfunction solid(x, y) {\n  var h = P_CFG.half;\n  return bwe.tilemap.blocked(x - h, y - h, h * 2, h * 2);\n}\n\nfunction clamp(me) {\n  var x = Math.max(16, Math.min(P_STATE.mapW - 16, me.x));\n  var y = Math.max(16, Math.min(P_STATE.mapH - 16, me.y));\n  if (x !== me.x || y !== me.y) me.setPos(x, y);\n}\n\n/** 点火把：点**面前那一格**（偏一格 = 32px，保证不会因为站在格子边缘而点到脚下）。\n *  注意：不能点脚下 —— 实体自身的材质会盖住脚下格的材质（引擎兜底 stone），\n *  所以「踩在草地上点自己」永远点不着，这是引擎语义（§2.11.1 实体材质优先）。 */\nfunction ignite(me) {\n  var fx = P_STATE.faceX;\n  var fy = P_STATE.faceY;\n  if (fx === 0 && fy === 0) fy = 1;\n  var cell = bwe.grid.toCell(me.x + fx * 32, me.y + fy * 32);\n  var mat = bwe.material.of(cell.cx, cell.cy);\n  if (!flammable(mat)) {\n    bwe.log(\"[涌现] 点火失败：(\" + cell.cx + \",\" + cell.cy + \") 材质 \" + mat + \" 不可燃\");\n    return;\n  }\n  bwe.field.emit(\"fire\", cell.cx, cell.cy, 1.0);\n  // 点火 = 制造噪音：守卫的第二感知通道（引擎只存数据，去不去查由 guard.js 决定）\n  bwe.noise.emit(cell.cx * 32 + 16, cell.cy * 32 + 16, { radius: P_CFG.noiseRadius, intensity: 1.2, tag: \"combat\" });\n  P_STATE.ignites += 1;\n  bwe.log(\"[涌现] 点火 (\" + cell.cx + \",\" + cell.cy + \") 强度 1.0 材质 \" + mat + \"（第 \" + P_STATE.ignites + \" 次）\");\n}\n\nfunction flammable(mat) {\n  if (!mat) return false;\n  var def = bwe.material.get(mat);\n  return !!def && typeof def.flammable === \"number\" && def.flammable > 0;\n}\n\n/** 推：对最近的可推物体施冲击力（jbox2d applyImpulse）。 */\nfunction push(me) {\n  var target = nearestTagged(me, \"可推\", P_CFG.pushRange);\n  if (!target) {\n    bwe.log(\"[涌现] 推力落空：附近没有可推物体\");\n    return;\n  }\n  var dx = target.x - me.x;\n  var dy = target.y - me.y;\n  var len = Math.sqrt(dx * dx + dy * dy);\n  if (len < 0.001) { dx = 0; dy = -1; len = 1; }\n  bwe.physics.applyImpulse(target, (dx / len) * P_CFG.pushImpulse, (dy / len) * P_CFG.pushImpulse);\n  P_STATE.pushes += 1;\n  bwe.log(\"[涌现] 推 \" + target.name + \" 冲量 \" + P_CFG.pushImpulse + \"（第 \" + P_STATE.pushes + \" 次）\");\n}\n\nfunction nearestTagged(me, tag, range) {\n  var list = bwe.world.findAll({ tag: tag }) || [];\n  var best = null;\n  var bestD = range;\n  for (var i = 0; i < list.length; i++) {\n    var d = me.distanceTo(list[i]);\n    if (d < bestD) { bestD = d; best = list[i]; }\n  }\n  return best;\n}\n\n/** 左键：朝鼠标世界坐标丢油瓶（力度按距离），落地碰撞后由 world.js 的点火钩子引燃。 */\nfunction throwBottle(me) {\n  var bottle = nearestTagged(me, \"油瓶\", 400);\n  if (!bottle) {\n    bwe.log(\"[涌现] 丢油瓶失败：身上没有油瓶\");\n    return;\n  }\n  var m = bwe.input.mouse;\n  var tx = m ? m.worldX : me.x;\n  var ty = m ? m.worldY : me.y - 96;\n  bwe.physics.throwAt(bottle, tx, ty, P_CFG.throwSpeed);\n  P_STATE.throws += 1;\n  bwe.log(\"[涌现] 丢油瓶 -> (\" + Math.round(tx) + \",\" + Math.round(ty) + \") 速度 \" + P_CFG.throwSpeed);\n}\n\nfunction onDamage(ctx, amount, from) {\n  bwe.log(\"[涌现] 玩家受击 -\" + Math.round(amount) + \" 剩 \" + Math.round(ctx.self.hp));\n}\n",
      "lang": "js"
    },
    "guard": {
      "name": "guard",
      "file": "guard.js",
      "source": "// guard.js —— 守卫：巡逻 → 听到噪音 investigate → 看见玩家 chase → 同阵营 alert。\n// ⚠ 同一段脚本会挂到多个守卫对象上：模块级变量是共享的，所以「每实体状态」必须按 e.id 分桶。\nvar G_CFG = {\n  patrolSpeed: 62,\n  chaseSpeed: 96,\n  attackRange: 36,\n  damage: 7,\n  cooldown: 1.2,\n  waypoints: [[16, 8], [23, 8], [23, 11], [16, 11]]\n};\n\nvar G_POOL = { agents: {}, alerted: 0, spottings: 0, alertHook: false, lastAlertAt: 0 };\n\nfunction agentOf(me) {\n  var key = me.id;\n  if (!G_POOL.agents[key]) {\n    G_POOL.agents[key] = { wp: Object.keys(G_POOL.agents).length % G_CFG.waypoints.length, cool: 0, nav: null };\n  }\n  return G_POOL.agents[key];\n}\n\nfunction onStart(ctx) {\n  var me = ctx.self;\n  bwe.ai.attach(me, { sight: 300, fov: 200, hearing: 560, memory: 8, speed: G_CFG.chaseSpeed });\n  bwe.faction.set(me, \"guard\");\n  bwe.ai.setState(me, \"patrol\");\n  agentOf(me);\n  bwe.log(\"[涌现] 守卫就绪：\" + me.name);\n  // 同阵营警报：引擎只负责传播（一跳延迟、按对象逐个派发），收到之后干什么由脚本决定。\n  // 注意 payload：info.entity = **收到警报的那个守卫**，info.from = 发警报的守卫，info.position = 目标点。\n  if (!G_POOL.alertHook) {\n    G_POOL.alertHook = true;\n    bwe.ai.onAlert(function (info) {\n      if (!info || !info.position || !info.entity) return;\n      var who = info.entity;\n      if (info.from && info.from.id === who.id) return;\n      if (bwe.ai.state(who) === \"chase\") return; // 已经在追了，不用再\"去查\"\n      // 同一帧可能被投递多次（每个守卫一个 handler 实例），去重\n      var stamp = bwe.time.now;\n      if (G_POOL.lastAlertAt && stamp - G_POOL.lastAlertAt < 0.2) return;\n      G_POOL.lastAlertAt = stamp;\n      var st = agentOf(who);\n      bwe.ai.setState(who, \"investigate\");\n      st.nav = { x: info.position.x, y: info.position.y, t: 0 };\n      G_POOL.alerted += 1;\n      bwe.log(\"[涌现] 守卫 \" + who.name + \" 收到警报 → investigate（来自 \" + (info.from ? info.from.name : \"?\") + \"）\");\n    });\n  }\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!me || me.alive === false) return;\n  var st = agentOf(me);\n  if (st.cool > 0) st.cool = Math.max(0, st.cool - dt);\n  if (st.nav) st.nav.t += dt;\n\n  var player = bwe.world.find({ tag: \"玩家\" });\n  // 1) 视觉优先：看见敌对目标 → chase + 同阵营 alert\n  if (player && player.alive !== false && bwe.sense.canSee(me, player)) {\n    if (bwe.ai.state(me) !== \"chase\") {\n      bwe.ai.setState(me, \"chase\");\n      G_POOL.spottings += 1;\n      bwe.log(\"[涌现] 守卫 \" + me.name + \" 状态 → chase（看见玩家）\");\n      bwe.ai.alert(me, { x: player.x, y: player.y });\n      bwe.noise.emit(me.x, me.y, { radius: 520, intensity: 1.0, tag: \"combat\" });\n    }\n    chase(me, player, dt, st);\n    return;\n  }\n\n  // 2) 听觉：噪音写进 lastKnown（from=noise），脚本据此决定去查\n  var known = bwe.sense.lastKnown(me);\n  var state = bwe.ai.state(me);\n  if (known && known.from === \"noise\" && state !== \"chase\" && state !== \"investigate\") {\n    // 记下「听到时到底看不看得见」——E7 的断言依据：隔墙听得到、但看不见\n    var sees = player ? bwe.sense.canSee(me, player) : false;\n    bwe.ai.setState(me, \"investigate\");\n    st.nav = { x: known.x, y: known.y, t: 0 };\n    bwe.log(\"[涌现] 守卫 \" + me.name + \" 状态 → investigate（噪声源 \" + Math.round(known.x) + \",\" + Math.round(known.y)\n      + \"）canSee=\" + sees);\n  }\n\n  if (bwe.ai.state(me) === \"investigate\") {\n    investigate(me, dt, st);\n    return;\n  }\n  patrol(me, dt, st);\n}\n\nfunction patrol(me, dt, st) {\n  var wp = G_CFG.waypoints[st.wp % G_CFG.waypoints.length];\n  var target = { x: wp[0] * 32 + 16, y: wp[1] * 32 + 16 };\n  if (stepToward(me, target.x, target.y, G_CFG.patrolSpeed, dt)) {\n    st.wp = (st.wp + 1) % G_CFG.waypoints.length;\n  }\n  if (bwe.ai.state(me) !== \"patrol\") bwe.ai.setState(me, \"patrol\");\n}\n\nfunction investigate(me, dt, st) {\n  var nav = st.nav;\n  if (!nav || nav.t > 6) {\n    bwe.ai.setState(me, \"patrol\");\n    st.nav = null;\n    bwe.log(\"[涌现] 守卫 \" + me.name + \" 状态 → patrol（调查结束）\");\n    return;\n  }\n  stepToward(me, nav.x, nav.y, G_CFG.chaseSpeed, dt);\n  var d = Math.sqrt((me.x - nav.x) * (me.x - nav.x) + (me.y - nav.y) * (me.y - nav.y));\n  if (d < 40) {\n    // 到现场没发现人：转回巡逻\n    bwe.ai.setState(me, \"patrol\");\n    st.nav = null;\n  }\n}\n\nfunction chase(me, player, dt, st) {\n  var d = me.distanceTo(player);\n  if (d <= G_CFG.attackRange) {\n    if (st.cool <= 0) {\n      st.cool = G_CFG.cooldown;\n      player.damage(G_CFG.damage);\n      bwe.noise.emit(me.x, me.y, { radius: 460, intensity: 1.0, tag: \"combat\" });\n      bwe.log(\"[涌现] 守卫 \" + me.name + \" 攻击玩家 -\" + G_CFG.damage);\n    }\n    return;\n  }\n  stepToward(me, player.x, player.y, G_CFG.chaseSpeed, dt);\n}\n\n/** 朝目标走一步（A* 找路，0.25 秒重算一次缓存；被墙卡住时退回直线）。\n *  A* 每帧算一次在 40x30 上会吃掉 2~3ms 帧预算，所以做节流——这也是脚本侧该有的写法示范。 */\nfunction stepToward(me, tx, ty, speed, dt) {\n  var dx = tx - me.x;\n  var dy = ty - me.y;\n  var d = Math.sqrt(dx * dx + dy * dy);\n  if (d < 6) return true;\n  var st = agentOf(me);\n  st.repath = (st.repath || 0) - dt;\n  if (!st.path || st.repath <= 0) {\n    st.repath = 0.25;\n    st.path = bwe.nav.find(me.pos, { x: tx, y: ty }, { diagonal: true, maxNodes: 800 });\n    st.pathGoal = { x: tx, y: ty };\n  }\n  var step = speed * dt;\n  var path = st.path;\n  if (path && path.length > 1 && st.pathGoal) {\n    // 路点走完后重新找路（目标可能在移动）\n    var next = path[1];\n    var pdx = next.x - me.x;\n    var pdy = next.y - me.y;\n    var plen = Math.sqrt(pdx * pdx + pdy * pdy) || 1;\n    me.setPos(me.x + (pdx / plen) * Math.min(step, plen), me.y + (pdy / plen) * Math.min(step, plen));\n    if (plen < 8 && path.length > 2) st.path = path.slice(1);\n    return false;\n  }\n  var len = d || 1;\n  me.setPos(me.x + (dx / len) * step, me.y + (dy / len) * step);\n  return false;\n}\n",
      "lang": "js"
    },
    "civilian": {
      "name": "civilian",
      "file": "civilian.js",
      "source": "// civilian.js —— 平民：看见火 → flee；主方向朝水渠（东），东边也有火就改往北。\n// 状态机写在 JS 里（引擎只提供感知/记忆/状态存储）。\nvar C_CFG = {\n  speed: 70,\n  fleeSpeed: 150,\n  fearCells: 5,\n  fireThreshold: 0.12,\n  channelX: 22 * 32 + 32\n};\n\nvar C_STATE = { ready: false, me: null, dir: \"east\", panic: 0 };\n\nfunction onStart(ctx) {\n  C_STATE.me = ctx.self;\n  bwe.ai.attach(ctx.self, { sight: 220, fov: 360, hearing: 260, memory: 5, speed: C_CFG.fleeSpeed });\n  bwe.faction.set(ctx.self, \"civilian\");\n  bwe.ai.setState(ctx.self, \"idle\");\n  C_STATE.ready = true;\n  bwe.log(\"[涌现] 平民就绪：\" + ctx.self.name);\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!C_STATE.ready || !me || me.alive === false) return;\n  var danger = maxFireAround(me, C_CFG.fearCells);\n  var state = bwe.ai.state(me);\n\n  if (danger > C_CFG.fireThreshold) {\n    if (state !== \"flee\") {\n      bwe.ai.setState(me, \"flee\");\n      C_STATE.panic += 1;\n      bwe.log(\"[涌现] 平民 状态 → flee（附近火势 \" + (Math.round(danger * 100) / 100) + \"）\");\n      bwe.noise.emit(me.x, me.y, { radius: 360, intensity: 1.0, tag: \"panic\" });\n    }\n    flee(me, dt);\n    return;\n  }\n  if (state === \"flee\") {\n    bwe.ai.setState(me, \"idle\");\n    bwe.log(\"[涌现] 平民 状态 → idle（火势远离）\");\n  }\n  // 没火的时候原地小幅踱步（也顺便演示 idle 决策）\n  idle(me, dt);\n}\n\n/** 逃跑：主方向朝水渠；如果东边也烧起来了（火线绕过来），改往北跑 —— 分支由 JS 决定。 */\nfunction flee(me, dt) {\n  var eastFire = maxFireInRect(me, 1, 4, -2, 2);\n  C_STATE.dir = eastFire > 0.5 ? \"north\" : \"east\";\n  var tx = C_STATE.dir === \"east\" ? C_CFG.channelX : me.x;\n  var ty = C_STATE.dir === \"east\" ? me.y : me.y - 160;\n  var dx = tx - me.x;\n  var dy = ty - me.y;\n  var len = Math.sqrt(dx * dx + dy * dy) || 1;\n  var step = C_CFG.fleeSpeed * dt;\n  var nx = me.x + (dx / len) * step;\n  var ny = me.y + (dy / len) * step;\n  if (!blocked(nx, me.y)) me.setPos(nx, me.y);\n  if (!blocked(me.x, ny)) me.setPos(me.x, ny);\n}\n\nfunction idle(me, dt) {\n  // 轻微绕圈，避免完全静止（也验证 AI 状态 idle 下的行为）\n  var t = bwe.time.now;\n  var nx = me.x + Math.cos(t * 0.7) * 8 * dt;\n  var ny = me.y + Math.sin(t * 0.9) * 8 * dt;\n  if (!blocked(nx, ny)) me.setPos(nx, ny);\n}\n\nfunction blocked(x, y) {\n  return bwe.tilemap.blocked(x - 8, y - 8, 16, 16);\n}\n\nfunction maxFireAround(me, cells) {\n  var c = bwe.grid.toCell(me.x, me.y);\n  var best = 0;\n  for (var dy = -cells; dy <= cells; dy++) {\n    for (var dx = -cells; dx <= cells; dx++) {\n      var v = bwe.field.sample(\"fire\", c.cx + dx, c.cy + dy);\n      if (v > best) best = v;\n    }\n  }\n  return best;\n}\n\nfunction maxFireInRect(me, x0, x1, y0, y1) {\n  var c = bwe.grid.toCell(me.x, me.y);\n  var best = 0;\n  for (var cy = y0; cy <= y1; cy++) {\n    for (var cx = x0; cx <= x1; cx++) {\n      var v = bwe.field.sample(\"fire\", c.cx + cx, c.cy + cy);\n      if (v > best) best = v;\n    }\n  }\n  return best;\n}\n",
      "lang": "js"
    },
    "bottle": {
      "name": "bottle",
      "file": "bottle.js",
      "source": "// bottle.js —— 油瓶：物理体；被 throwAt / applyImpulse 推着走，落地碰撞由 world.js 的全局钩子点火。\n// ⚠ 多个油瓶共用这段脚本 → 每瓶状态按 e.id 分桶。\n// ⚠ bwe.physics.enable() 发生在场景脚本（onSceneStart），晚于对象 onStart，\n//    所以刚体必须**延迟到第一帧 onUpdate** 再建，否则会被引擎按「物理未启用」拒绝。\nvar B_POOL = { bodied: {}, fastLogged: {} };\n\nfunction onStart(ctx) {\n  bwe.log(\"[涌现] 油瓶就绪：\" + ctx.self.name);\n}\n\nfunction onUpdate(ctx, dt) {\n  var me = ctx.self;\n  if (!me || me.alive === false) return;\n  if (!B_POOL.bodied[me.id]) {\n    B_POOL.bodied[me.id] = true;\n    bwe.physics.body(me, { type: \"dynamic\", shape: \"circle\", radius: 7, density: 2.2, friction: 0.25, restitution: 0.35 });\n  }\n  var v = bwe.physics.velocity(me);\n  if (v && (Math.abs(v.vx) + Math.abs(v.vy)) > 90 && !B_POOL.fastLogged[me.id]) {\n    B_POOL.fastLogged[me.id] = true;\n    bwe.log(\"[涌现] 油瓶在飞：\" + me.name + \" 速度 \" + Math.round(Math.sqrt(v.vx * v.vx + v.vy * v.vy)) + \" px/s\");\n  }\n}\n",
      "lang": "js"
    },
    "hud": {
      "name": "hud",
      "file": "hud.js",
      "source": "// hud.js —— HUD + 世界叠色：材质场是逻辑概念，火/烟/湿要靠 bwe.draw 画出来才看得见。\nvar HUD_STATE = { ready: false, frame: 0, burning: 0, noises: 0, fps: 0, fireCells: 0 };\n\nfunction onStart(ctx) {\n  HUD_STATE.ready = true;\n  bwe.log(\"[涌现] HUD 就绪\");\n}\n\nfunction onUpdate(ctx, dt) {\n  if (!HUD_STATE.ready) return;\n  HUD_STATE.frame += 1;\n  HUD_STATE.fps = dt > 0 ? Math.round(1 / dt) : 0;\n  // 火焰叠加每帧画（火是动态的）；统计/文字每 6 帧才刷，省开销\n  drawFire();\n  if (HUD_STATE.frame % 6 === 0) {\n    var burning = bwe.field.burning() || [];\n    HUD_STATE.burning = burning.length;\n    var noises = bwe.noise.events() || [];\n    HUD_STATE.noises = noises.length;\n  }\n  if (HUD_STATE.frame % 30 === 0) drawHudText();\n}\n\n/** 把正在燃烧的格子画成橙红色（alpha 按强度），另外把湿格子画成淡蓝。 */\nfunction drawFire() {\n  var burning = bwe.field.burning() || [];\n  HUD_STATE.fireCells = burning.length;\n  if (burning.length === 0) return;\n  bwe.draw.world(function () {\n    for (var i = 0; i < burning.length; i++) {\n      var b = burning[i];\n      var k = Math.min(1, b.intensity);\n      // 火心亮黄 → 边缘橙红\n      var color = k > 0.6 ? \"#ffd24a\" : \"#ff7a3c\";\n      bwe.draw.rect(b.cx * 32, b.cy * 32, 32, 32, { fill: color, alpha: 0.25 + 0.5 * k });\n    }\n  });\n}\n\nfunction drawHudText() {\n  var player = bwe.world.find({ tag: \"玩家\" });\n  var hp = player ? player.hp : 0;\n  var hpMax = player && player.hpMax > 0 ? player.hpMax : 1;\n  var guards = bwe.world.findAll({ tag: \"守卫\" }) || [];\n  var guardText = [];\n  for (var i = 0; i < guards.length; i++) guardText.push(guards[i].name + \":\" + bwe.ai.state(guards[i]));\n  var civ = bwe.world.find({ tag: \"平民\" });\n\n  bwe.draw.rect(16, 16, 380, 116, { fill: \"#0a1018\", stroke: \"#3a4a62\", radius: 8, alpha: 0.88 });\n  bwe.draw.text(30, 24, \"涌现沙盘 · 生命\", { size: 13, color: \"#a9c2dd\" });\n  bwe.draw.bar(30, 44, 352, 13, hp / hpMax, { bg: \"#182231\", fg: \"#3ddc84\", border: \"#0a111b\" });\n  bwe.draw.text(30, 66, \"燃烧 \" + HUD_STATE.burning + \" 格 · 噪音 \" + HUD_STATE.noises + \" 条 · FPS \" + HUD_STATE.fps,\n    { size: 13, color: \"#ffb24a\" });\n  bwe.draw.text(30, 86, guardText.join(\"  \"), { size: 12, color: \"#ff8a92\" });\n  bwe.draw.text(30, 104, \"平民:\" + (civ ? bwe.ai.state(civ) : \"-\") + \" WASD 移动 · 空格 点火 · F 推 · 左键 丢瓶\",\n    { size: 11, color: \"#7f97b6\" });\n}\n",
      "lang": "js"
    }
  },
  "variables": {
    "涌现.种子": "20261026",
    "材质.草地易燃度": "0.8",
    "材质.木墙燃烧时间": "4.0",
    "材质.水渠": "永久灭火"
  },
  "masterVolume": 0.7
}
