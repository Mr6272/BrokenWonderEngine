  "BWE: log": {
    "scope": "javascript",
    "prefix": "bwe.log",
    "body": ["bwe.log(${1:\"消息\"});"],
    "description": "BWE 日志（不要用 console.log）"
  },
  "BWE: after": {
    "scope": "javascript",
    "prefix": "bwe.after",
    "body": ["bwe.after(${1:0.5}, function () {", "\t$0", "});"],
    "description": "BWE 延时执行一次（代替 setTimeout）"
  },
  "BWE: every": {
    "scope": "javascript",
    "prefix": "bwe.every",
    "body": ["bwe.every(${1:1}, function () {", "\t$0", "});"],
    "description": "BWE 重复执行（代替 setInterval）"
