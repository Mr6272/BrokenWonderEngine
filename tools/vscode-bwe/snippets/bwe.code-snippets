  "BWE: world.find": {
    "scope": "javascript",
    "prefix": "bwe.world.find",
    "body": ["bwe.world.find(${1:\"名字\"})"],
    "description": "按名字 / 标签查找实体"
  },
  "BWE: world.spawn": {
    "scope": "javascript",
    "prefix": "bwe.world.spawn",
    "body": [
      "bwe.world.spawn({",
      "\tx: ${1:0},",
      "\ty: ${2:0},",
      "\tasset: \"${3:素材名}\",",
      "\tname: \"${4:名字}\"",
      "});"
    ],
    "description": "运行时生成一个实体"
  },
  "BWE: draw.text": {
    "scope": "javascript",
    "prefix": "bwe.draw.text",
    "body": ["bwe.draw.text(${1:16}, ${2:16}, ${3:\"文字\"}, { size: ${4:14}, color: \"${5:#fff}\" });"],
    "description": "HUD 文字"
  },
  "BWE: draw.rect": {
    "scope": "javascript",
    "prefix": "bwe.draw.rect",
    "body": ["bwe.draw.rect(${1:0}, ${2:0}, ${3:100}, ${4:40}, { fill: \"${5:#000000cc}\", radius: 6 });"],
    "description": "HUD 矩形"
  },
  "BWE: save.set": {
    "scope": "javascript",
    "prefix": "bwe.save.set",
    "body": ["bwe.save.set(\"${1:key}\", ${2:value});"],
    "description": "写本地存档"
  },
  "BWE: new script skeleton": {
    "scope": "javascript",
    "prefix": "bwescript",
    "body": [
      "// ${1:脚本名}.js —— BWE 对象脚本（Rhino ES5，不要用 import / require / export）",
      "var ${2:STATE} = { ready: false };",
      "",
      "function onStart(ctx) {",
      "\t${2:STATE}.ready = true;",
      "\tbwe.log(\"[脚本] ${1:脚本名} ready\");",
      "}",
      "",
      "function onUpdate(ctx, dt) {",
      "\tif (!${2:STATE}.ready) return;",
      "\tvar e = ctx.self;",
      "\t$0",
      "}"
    ],
    "description": "新建一个 BWE 脚本骨架（含 onStart / onUpdate）"
  }
}
